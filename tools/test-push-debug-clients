#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd)"
test_root="$(mktemp -d)"
trap 'rm -rf "$test_root"' EXIT

fail()
{
    echo "Push debugger client test failed: $*" >&2
    exit 1
}

new_debug_home()
{
    test_home="$(mktemp -d "${test_root}/home.XXXXXX")"
    test_debug="${test_home}/.drivenbymoss/pull/debug"
    mkdir -p "$test_debug"
    touch "${test_debug}/enabled"
}

wait_for_file()
{
    for _ in {1..200}
    do
        [[ -f "$1" ]] && return
        sleep 0.01
    done
    fail "timed out waiting for $1"
}

assert_status()
{
    expected="$1"
    shift
    set +e
    "$@" >/dev/null 2>&1
    actual=$?
    set -e
    [[ "$actual" == "$expected" ]] || fail "expected status ${expected}, got ${actual}"
}

write_navigation_status()
{
    printf '%s\tREADY\t%s\tSESSION\tTRACK\tfalse\tfalse\tfalse\t5\ttrack-a\t2\tfalse\tOFF\ttrue\tfalse\tfalse\t-\t-\tfalse\t-\t-\tNONE\tOUTPUT\tPAD29\tpush.pad.29\t64\t100\tEXCLUSIVE\ttrue\ttrue\ttrue\t0C2238\t43:0:false\tbase=0:64:43;blink=-\t\n' "$1" "$2" > "$test_debug/navigate-status.txt"
}

new_debug_home
assert_status 75 env -u PULL_LIVE_LOCK_TOKEN HOME="$test_home" "${script_dir}/push-debug-request" valid 'NOTE/workspace=false'
assert_status 75 env -u PULL_LIVE_LOCK_TOKEN HOME="$test_home" "${script_dir}/push-debug-trace" start valid
assert_status 75 env -u PULL_LIVE_LOCK_TOKEN HOME="$test_home" "${script_dir}/push-debug-trace" stop valid
assert_status 75 env -u PULL_LIVE_LOCK_TOKEN PUSH_DEBUG_SURFACE_NO_OPEN=true HOME="$test_home" "${script_dir}/push-debug-surface"

test_owner_file="${test_root}/live.owner"
test_token="push-debug-client-test"
printf 'pid=%s\ntoken=%s\n' "$$" "$test_token" > "$test_owner_file"
export PULL_LIVE_LOCK_OWNER_FILE="$test_owner_file"
export PULL_LIVE_LOCK_TOKEN="$test_token"
assert_status 2 env HOME="$test_home" "${script_dir}/push-debug-request" 'bad label' 'NOTE/workspace=false'
printf -v oversized_step '%0600d' 0
assert_status 2 env HOME="$test_home" "${script_dir}/push-debug-request" valid "$oversized_step"
mkdir "$test_debug/client.lock"
assert_status 3 env HOME="$test_home" "${script_dir}/push-debug-request" valid 'NOTE/workspace=false'

new_debug_home
assert_status 2 env HOME="$test_home" "${script_dir}/push-debug-trace" start valid 61
assert_status 2 env HOME="$test_home" "${script_dir}/push-debug-trace" stop 'bad/id'
mkdir "$test_debug/trace-client.lock"
assert_status 3 env HOME="$test_home" "${script_dir}/push-debug-trace" start valid

new_debug_home
(
    wait_for_file "$test_debug/trace-request.txt"
    IFS=$'\t' read -r request_id action label duration < "$test_debug/trace-request.txt"
    [[ "$action" == "ARM" && "$label" == "button-test" && "$duration" == "12000" ]] || fail "trace arm request was malformed"
    printf 'stale\tARMED\tstale\t\t\n' > "$test_debug/trace-status.txt"
    sleep 0.05
    printf '%s\tARMED\t%s\t\t\n' "$request_id" "$request_id" > "$test_debug/trace-status.txt"
) &
trace_id="$(env HOME="$test_home" "${script_dir}/push-debug-trace" start button-test 12 2>/dev/null)"
[[ -n "$trace_id" ]] || fail "trace start did not return an identifier"

rm -f "$test_debug/trace-request.txt"
(
    wait_for_file "$test_debug/trace-request.txt"
    IFS=$'\t' read -r stop_id action stopped_trace < "$test_debug/trace-request.txt"
    [[ "$action" == "STOP" && "$stopped_trace" == "$trace_id" ]] || fail "trace stop request was malformed"
    printf 'trace fixture\n' > "$test_debug/trace-fixture.tsv"
    printf '%s\tREADY\t%s\ttrace-fixture.tsv\t\n' "$stop_id" "$stopped_trace" > "$test_debug/trace-status.txt"
) &
trace_path="$(env HOME="$test_home" "${script_dir}/push-debug-trace" stop "$trace_id" 2>/dev/null)"
[[ "$trace_path" == "$test_debug/trace-fixture.tsv" ]] || fail "trace stop returned the wrong artifact"

new_debug_home
(
    wait_for_file "$test_debug/trace-request.txt"
    IFS=$'\t' read -r failed_id _ < "$test_debug/trace-request.txt"
    printf '%s\tFAILED\t-\t-\tanother trace is already armed\n' "$failed_id" > "$test_debug/trace-status.txt"
) &
set +e
failure_output="$(env HOME="$test_home" "${script_dir}/push-debug-trace" start collision 2>&1)"
failure_status=$?
set -e
[[ "$failure_status" == "1" && "$failure_output" == *"another trace is already armed"* ]] || fail "trace client lost a server failure message"

new_debug_home
(
    wait_for_file "$test_debug/navigate-request.txt"
    IFS=$'\t' read -r request_id request_label _ < "$test_debug/navigate-request.txt"
    write_navigation_status stale stale
    sleep 0.05
    write_navigation_status "$request_id" "$request_label"
) &
navigation_output="$(env HOME="$test_home" "${script_dir}/push-debug-request" correlated 'NOTE/workspace=false' 2>&1)"
[[ "$navigation_output" == *"track_position=5 track_id=track-a track_generation=2"* ]] || fail "navigation client omitted selected-track identity"
[[ "$navigation_output" == *"pad_button=PAD29 pad_control=push.pad.29 pad_midi_note=64"* ]] || fail "navigation client omitted pad proof fields"
[[ "$navigation_output" == *"pad_route=EXCLUSIVE mapping_desired=true mapping_active=true mapped_on=true"* ]] || fail "navigation client omitted pad route, mapping state, or mapped readback"
[[ ! -e "$test_debug/capture-request.txt" ]] || fail "navigation-only request emitted a capture"

new_debug_home
(
    wait_for_file "$test_debug/navigate-request.txt"
    IFS=$'\t' read -r failed_id failed_label _ < "$test_debug/navigate-request.txt"
    printf '%s\tFAILED\t%s\tSESSION\tTRACK\tfalse\tfalse\tfalse\t-1\t-\t0\tfalse\tOFF\tfalse\tfalse\tfalse\t-\t-\tfalse\t-\t-\tNONE\t-\t-\t-\t-\t-\t-\t-\t-\t-\t-\t-\t-\tpad route is unavailable\n' "$failed_id" "$failed_label" > "$test_debug/navigate-status.txt"
) &
set +e
failure_output="$(env HOME="$test_home" "${script_dir}/push-debug-request" failed-navigation 'NOTE/workspace=false' 2>&1)"
failure_status=$?
set -e
[[ "$failure_status" == "1" && "$failure_output" == *"pad route is unavailable"* ]] || fail "navigation client lost a server failure message"

new_debug_home
env HOME="$test_home" "${script_dir}/push-debug-request" interruptible 'NOTE/workspace=false' >/dev/null 2>&1 &
client_pid=$!
wait_for_file "$test_debug/navigate-request.txt"
IFS=$'\t' read -r request_id request_label _ < "$test_debug/navigate-request.txt"
kill -TERM "$client_pid"
sleep 0.05
kill -0 "$client_pid" 2>/dev/null || fail "interrupted client exited before terminal state"
[[ -d "$test_debug/client.lock" ]] || fail "interrupted client released its lock early"
write_navigation_status "$request_id" "$request_label"
assert_status 130 wait "$client_pid"
[[ ! -d "$test_debug/client.lock" ]] || fail "terminal client retained its lock"

new_debug_home
(
    wait_for_file "$test_debug/navigate-request.txt"
    IFS=$'\t' read -r navigation_id navigation_label _ < "$test_debug/navigate-request.txt"
    write_navigation_status "$navigation_id" "$navigation_label"
    wait_for_file "$test_debug/capture-request.txt"
    IFS=$'\t' read -r capture_id _ < "$test_debug/capture-request.txt"
    [[ "$capture_id" == "$navigation_id" && -d "$test_debug/client.lock" ]] || fail "capture lost request identity or lock"
    touch "$test_debug/fake.png"
    printf '%s\tREADY\tfake.png\t-\n' "$capture_id" > "$test_debug/capture-status.txt"
) &
capture="$(env HOME="$test_home" "${script_dir}/capture-push2-display" session 2>/dev/null)"
[[ "$capture" == "$test_debug/fake.png" ]] || fail "capture returned the wrong artifact"
[[ ! -d "$test_debug/client.lock" ]] || fail "capture retained its lock"

new_debug_home
(
    wait_for_file "$test_debug/capture-request.txt"
    IFS=$'\t' read -r capture_id _ < "$test_debug/capture-request.txt"
    printf '%s\tFAILED\t-\tcapture route is unavailable\n' "$capture_id" > "$test_debug/capture-status.txt"
) &
set +e
failure_output="$(env HOME="$test_home" "${script_dir}/capture-push2-display" 2>&1)"
failure_status=$?
set -e
[[ "$failure_status" == "1" && "$failure_output" == *"capture route is unavailable"* ]] || fail "capture client lost a server failure message"

echo "Push debugger client tests passed."
