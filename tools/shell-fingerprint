#!/usr/bin/env bash

set -euo pipefail

repository_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

calculate_fingerprint ()
{
    # A reloadable core links only against the parent-loaded core API. Shell implementation
    # changes are not a classloader compatibility boundary and must not block core hot reloads.
    git -C "$repository_dir" ls-files --cached --others --exclude-standard -- \
        pull-core-api/pom.xml \
        pull-core-api/src/main |
        LC_ALL=C sort |
        while IFS= read -r path
        do
            [[ -f "$repository_dir/$path" ]] || continue
            blob_id="$(git -C "$repository_dir" hash-object --no-filters "$path")"
            printf '%s %s\n' "$blob_id" "$path"
        done |
        git -C "$repository_dir" hash-object --stdin
}

fingerprint="$(calculate_fingerprint)"

if [[ $# -eq 0 ]]
then
    printf '%s\n' "$fingerprint"
elif [[ $# -eq 2 && "$1" == "--properties" ]]
then
    destination="$2"
    mkdir -p "$(dirname "$destination")"
    temporary="${destination}.tmp.$$"
    printf 'formatVersion=1\nfingerprint=%s\n' "$fingerprint" > "$temporary"
    mv "$temporary" "$destination"
else
    echo "Usage: tools/shell-fingerprint [--properties PATH]" >&2
    exit 2
fi
