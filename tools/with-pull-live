#!/usr/bin/env bash

set -euo pipefail

usage ()
{
    echo "Usage: tools/with-pull-live [--owner LABEL] [-- COMMAND [ARG ...]]" >&2
}

repository_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
lock_dir="${PULL_LIVE_LOCK_DIR:-${HOME}/.drivenbymoss/pull/locks}"
lock_file="${lock_dir}/live.lock"
owner_file="${lock_dir}/live.owner"
owner="${PULL_LIVE_OWNER:-}"

while (( $# > 0 ))
do
    case "$1" in
        --owner)
            (( $# >= 2 )) || { usage; exit 64; }
            owner="$2"
            shift 2
            ;;
        --)
            shift
            break
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        -* )
            usage
            exit 64
            ;;
        *)
            break
            ;;
    esac
done

if [[ -n "${PULL_LIVE_LOCK_TOKEN:-}" ]]
then
    "${repository_dir}/tools/require-pull-live"
    if (( $# > 0 ))
    then
        exec "$@"
    fi
    exec "${SHELL:-/bin/zsh}" -i
fi

if [[ -z "$owner" ]]
then
    owner="$(git -C "$repository_dir" branch --show-current 2>/dev/null || true)"
fi
if [[ -z "$owner" ]]
then
    owner="$(basename "$repository_dir")"
fi

mkdir -p "$lock_dir"
exec 9>"$lock_file"
lock_status=0
if [[ "$(uname -s)" == "Darwin" ]]
then
    lockf -s -t 0 9 || lock_status=$?
elif command -v flock >/dev/null 2>&1
then
    flock -n 9 || lock_status=$?
else
    echo "Pull live locking requires lockf on macOS or flock on this platform." >&2
    exit 69
fi
if (( lock_status != 0 ))
then
    echo "The Pull live environment is already in use." >&2
    if [[ -f "$owner_file" ]]
    then
        sed 's/^/  /' "$owner_file" >&2
    fi
    echo "Continue with offline work and retry after that owner finishes." >&2
    exit 75
fi

lock_token="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
owner_temp="${owner_file}.$$"
cleanup ()
{
    rm -f "$owner_temp" "$owner_file"
}
trap cleanup EXIT

{
    printf 'owner=%s\n' "$owner"
    printf 'branch=%s\n' "$(git -C "$repository_dir" branch --show-current 2>/dev/null || true)"
    printf 'worktree=%s\n' "$repository_dir"
    printf 'pid=%s\n' "$$"
    printf 'token=%s\n' "$lock_token"
    printf 'started=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
} > "$owner_temp"
mv "$owner_temp" "$owner_file"

export PULL_LIVE_LOCK_OWNER_FILE="$owner_file"
export PULL_LIVE_LOCK_TOKEN="$lock_token"
export PULL_LIVE_OWNER="$owner"

child_pid=""
stop_child ()
{
    signal="$1"
    status="$2"
    trap - INT TERM HUP
    cleanup
    if [[ -n "$child_pid" ]] && kill -0 "$child_pid" 2>/dev/null
    then
        kill -s "$signal" "$child_pid" 2>/dev/null || true
        wait "$child_pid" 2>/dev/null || true
    fi
    exit "$status"
}
trap 'stop_child INT 130' INT
trap 'stop_child TERM 143' TERM
trap 'stop_child HUP 129' HUP

echo "Pull live environment acquired by ${owner}." >&2
set +e
if (( $# > 0 ))
then
    "$@" 9>&- <&0 &
else
    echo "Run the reload/install/live-test sequence here; exit releases the lease." >&2
    "${SHELL:-/bin/zsh}" -i 9>&- <&0 &
fi
child_pid=$!
wait "$child_pid"
command_status=$?
child_pid=""
set -e
exit "$command_status"
