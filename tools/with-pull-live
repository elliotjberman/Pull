#!/usr/bin/env bash

set -euo pipefail

usage ()
{
    echo "Usage: tools/with-pull-live [--owner LABEL] [--wait SECONDS] [-- COMMAND [ARG ...]]" >&2
}

repository_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
lock_dir="${PULL_LIVE_LOCK_DIR:-${HOME}/.drivenbymoss/pull/locks}"
lock_file="${lock_dir}/live.lock"
owner_file="${lock_dir}/live.owner"
owner="${PULL_LIVE_OWNER:-}"
wait_seconds="${PULL_LIVE_WAIT_SECONDS:-0}"

while (( $# > 0 ))
do
    case "$1" in
        --owner)
            (( $# >= 2 )) || { usage; exit 64; }
            owner="$2"
            shift 2
            ;;
        --wait)
            (( $# >= 2 )) || { usage; exit 64; }
            wait_seconds="$2"
            shift 2
            ;;
        --)
            shift
            break
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        -* )
            usage
            exit 64
            ;;
        *)
            break
            ;;
    esac
done

case "$wait_seconds" in
    ''|*[!0-9]*)
        echo "--wait must be a non-negative integer" >&2
        exit 64
        ;;
esac

if [[ -n "${PULL_LIVE_LOCK_HELD:-}" ]]
then
    if (( $# > 0 ))
    then
        exec "$@"
    fi
    exec "${SHELL:-/bin/zsh}" -i
fi

if [[ -z "$owner" ]]
then
    owner="$(git -C "$repository_dir" branch --show-current 2>/dev/null || true)"
fi
if [[ -z "$owner" ]]
then
    owner="$(basename "$repository_dir")"
fi

mkdir -p "$lock_dir"
exec 9>"$lock_file"
if ! lockf -s -t "$wait_seconds" 9
then
    echo "The Pull live environment is already in use." >&2
    if [[ -f "$owner_file" ]]
    then
        sed 's/^/  /' "$owner_file" >&2
    fi
    echo "Continue with offline work, or retry with --wait SECONDS." >&2
    exit 75
fi

owner_temp="${owner_file}.$$"
cleanup ()
{
    rm -f "$owner_temp" "$owner_file"
}
trap cleanup EXIT

{
    printf 'owner=%s\n' "$owner"
    printf 'branch=%s\n' "$(git -C "$repository_dir" branch --show-current 2>/dev/null || true)"
    printf 'worktree=%s\n' "$repository_dir"
    printf 'pid=%s\n' "$$"
    printf 'started=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
} > "$owner_temp"
mv "$owner_temp" "$owner_file"

export PULL_LIVE_LOCK_HELD="$lock_file"
export PULL_LIVE_OWNER="$owner"

echo "Pull live environment acquired by ${owner}." >&2
if (( $# > 0 ))
then
    "$@"
else
    echo "Run the reload/install/live-test sequence here; exit releases the lease." >&2
    "${SHELL:-/bin/zsh}" -i
fi
