#!/usr/bin/env bash

set -euo pipefail

debug_dir="${HOME}/.drivenbymoss/pull/debug"
navigation_request_path="${debug_dir}/navigate-request.txt"
navigation_status_path="${debug_dir}/navigate-status.txt"
capture_request_path="${debug_dir}/capture-request.txt"
capture_status_path="${debug_dir}/capture-status.txt"
latest_status_path="${debug_dir}/latest-frame.txt"
sample_rate_path="${debug_dir}/frame-sample-rate.txt"
lock_dir="${debug_dir}/client.lock"
enabled_path="${debug_dir}/enabled"

usage()
{
    echo "Usage: $0 [mix|master|project-macros|session|--enable|--disable|--sample-rate N|--stats]" >&2
}

target="${1:-}"
navigation_only=false
navigation_label=""
navigation_steps=()
if [[ "$target" == "--navigate" ]]
then
    if (( $# < 3 || $# > 6 ))
    then
        echo "Usage: tools/push-debug-request LABEL STEP [STEP ...]" >&2
        exit 2
    fi
    navigation_only=true
    navigation_label="$2"
    navigation_steps=("${@:3}")
    target=""
else
    if [[ "$target" == "--sample-rate" ]]
    then
        if (( $# != 2 )) || [[ ! "$2" =~ ^[0-9]+$ ]] || (( $2 < 1 || $2 > 600 ))
        then
            echo "Sample rate must be an integer from 1 through 600." >&2
            exit 2
        fi
        mkdir -p "$debug_dir"
        sample_rate_temp="${sample_rate_path}.$$-${RANDOM}.tmp"
        printf '%s\n' "$2" > "$sample_rate_temp"
        mv "$sample_rate_temp" "$sample_rate_path"
        echo "Push debug framebuffer sampling set to every $2 frame(s)." >&2
        exit 0
    fi
    if [[ "$target" == "--stats" ]]
    then
        if (( $# != 1 ))
        then
            usage
            exit 2
        fi
        if [[ ! -f "$latest_status_path" ]]
        then
            echo "No sampled Push framebuffer is available." >&2
            exit 1
        fi
        IFS=$'\t' read -r frame_revision frame_width frame_height sample_interval sampled_frames coalesced_frames capture_micros png_write_micros < "$latest_status_path"
        echo "frame=${frame_revision} size=${frame_width}x${frame_height} sample_every=${sample_interval} sampled=${sampled_frames} coalesced=${coalesced_frames} capture_us=${capture_micros} png_write_us=${png_write_micros}"
        exit 0
    fi
    if (( $# > 1 ))
    then
        usage
        exit 2
    fi
    case "$target" in
        ""|mix|master|project-macros|session)
            ;;
        --enable)
            mkdir -p "$debug_dir"
            touch "$enabled_path"
            echo "Push debugger enabled. Install this shell build and restart Bitwig to start its transports." >&2
            exit 0
            ;;
        --disable)
            rm -f "$enabled_path"
            echo "Push debugger disabled. Restart Bitwig to stop any running transports." >&2
            exit 0
            ;;
        *)
            usage
            exit 2
            ;;
    esac
fi

if [[ ! -f "$enabled_path" ]]
then
    echo "Push debugger is disabled. Run '$0 --enable', then install this shell build and restart Bitwig." >&2
    exit 4
fi

mkdir -p "$debug_dir"
if ! mkdir "$lock_dir" 2>/dev/null
then
    echo "Another Push debugger client is active (${lock_dir})." >&2
    exit 3
fi
printf '%s\n' "$$" > "${lock_dir}/pid"
cleanup()
{
    rm -f "${lock_dir}/pid"
    rmdir "$lock_dir" 2>/dev/null || true
}
navigation_pending=false
interrupted=false
interrupt()
{
    if [[ "$navigation_pending" == true ]]
    then
        interrupted=true
        echo "Interrupted; retaining the debugger lock until navigation reaches terminal state." >&2
        return
    fi
    exit 130
}
trap cleanup EXIT
trap interrupt INT TERM

request_id="$(date +%s)-$$-${RANDOM}"

if [[ -n "$target" || "$navigation_only" == true ]]
then
    if [[ "$navigation_only" != true ]]
    then
        navigation_label="$target"
        case "$target" in
            mix)
                navigation_steps=('NOTE/workspace=false' 'TRACK/mode=TRACK,workspace=false')
                ;;
            master)
                navigation_steps=('MASTERTRACK/mode=MASTER|MASTER_TEMP')
                ;;
            project-macros)
                navigation_steps=('SHIFT+SESSION/view=WORKSPACE,mode=WORKSPACE,workspace=true')
                ;;
            session)
                navigation_steps=(
                    'NOTE/workspace=false'
                    'TRACK/mode=TRACK,workspace=false'
                    'SESSION/view=SESSION,mode!=WORKSPACE|MASTER|MASTER_TEMP,workspace=false')
                ;;
        esac
    fi
    if [[ ! "$navigation_label" =~ ^[[:alnum:]._-]{1,80}$ ]]
    then
        echo "Navigation label must contain 1-80 letters, digits, dots, underscores, or hyphens." >&2
        exit 2
    fi
    for step in "${navigation_steps[@]}"
    do
        if [[ "$step" == *$'\t'* || "$step" == *$'\r'* || "$step" == *$'\n'* ]]
        then
            echo "Navigation steps cannot contain tabs or newlines." >&2
            exit 2
        fi
    done
    printf -v navigation_request '%s\t%s' "$request_id" "$navigation_label"
    for step in "${navigation_steps[@]}"
    do
        printf -v navigation_request '%s\t%s' "$navigation_request" "$step"
    done
    request_bytes="$(printf '%s\n' "$navigation_request" | LC_ALL=C wc -c)"
    if (( request_bytes > 512 ))
    then
        echo "Navigation request exceeds 512 bytes." >&2
        exit 2
    fi
    navigation_request_temp="${navigation_request_path}.${request_id}.tmp"
    printf '%s\n' "$navigation_request" > "$navigation_request_temp"
    trap '' INT TERM
    mv "$navigation_request_temp" "$navigation_request_path"
    navigation_pending=true
    trap interrupt INT TERM

    attempts=0
    while true
    do
        if [[ -f "$navigation_status_path" ]]
        then
            IFS=$'\t' read -r status_request_id status target_name view_id mode_id workspace_active repeat_active latch_active track_position track_id track_generation track_armed track_monitor can_hold_notes route_available route_desired route_desired_id route_desired_generation route_active route_active_id route_active_generation route_layout pad_probe pad_button pad_control pad_midi_note pad_velocity pad_route mapping_desired mapping_active mapped_on desired_rgb resolved_light transmitted_light message < "$navigation_status_path" || true
            if [[ "$status_request_id" == "$request_id" ]]
            then
                navigation_pending=false
                if [[ "$interrupted" == true ]]
                then
                    exit 130
                fi
                if [[ "$status" == "READY" ]]
                then
                    echo "Push navigation ready: target=${target_name} view=${view_id} mode=${mode_id} workspace=${workspace_active} repeat=${repeat_active} latch=${latch_active} track_position=${track_position} track_id=${track_id} track_generation=${track_generation} armed=${track_armed} monitor=${track_monitor} can_hold_notes=${can_hold_notes} route_available=${route_available} route_desired=${route_desired}:${route_desired_id}:${route_desired_generation} route_active=${route_active}:${route_active_id}:${route_active_generation} route_layout=${route_layout} pad_probe=${pad_probe} pad_button=${pad_button} pad_control=${pad_control} pad_midi_note=${pad_midi_note} pad_velocity=${pad_velocity} pad_route=${pad_route} mapping_desired=${mapping_desired} mapping_active=${mapping_active} mapped_on=${mapped_on} desired_rgb=${desired_rgb} resolved_light=${resolved_light} transmitted_light=${transmitted_light}" >&2
                    break
                fi
                echo "Push navigation failed: ${message:-unknown error} (view=${view_id} mode=${mode_id} repeat=${repeat_active} latch=${latch_active} track_position=${track_position} track_id=${track_id} track_generation=${track_generation} armed=${track_armed} monitor=${track_monitor} pad_probe=${pad_probe} pad_button=${pad_button} pad_control=${pad_control} pad_route=${pad_route} mapping_desired=${mapping_desired} mapping_active=${mapping_active} mapped_on=${mapped_on})" >&2
                exit 1
            fi
        fi
        attempts=$((attempts + 1))
        if (( attempts == 100 ))
        then
            echo "Still waiting for terminal navigation state; retaining the debugger lock." >&2
        fi
        sleep 0.1 || true
    done

    if [[ "$navigation_only" == true ]]
    then
        exit 0
    fi
fi

capture_request_temp="${capture_request_path}.${request_id}.tmp"
if [[ -n "$target" ]]
then
    printf '%s\tNEXT_FRAME\n' "$request_id" > "$capture_request_temp"
else
    printf '%s\n' "$request_id" > "$capture_request_temp"
fi
mv "$capture_request_temp" "$capture_request_path"

for _ in {1..100}
do
    if [[ -f "$capture_status_path" ]]
    then
        IFS=$'\t' read -r status_request_id status filename message < "$capture_status_path" || true
        if [[ "$status_request_id" == "$request_id" ]]
        then
            if [[ "$status" == "READY" && "$filename" != "-" && -f "${debug_dir}/${filename}" ]]
            then
                echo "${debug_dir}/${filename}"
                exit 0
            fi
            [[ "$message" == "-" ]] && message=""
            echo "Push display capture failed: ${message:-unknown error}" >&2
            exit 1
        fi
    fi
    sleep 0.1
done

echo "Timed out waiting for Bitwig to capture the Push display." >&2
exit 1
