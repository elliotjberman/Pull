#!/usr/bin/env python3
"""Read the live debug lifecycle receipt; optionally await worker retirement."""
import os
from pathlib import Path
import sys
import time

if sys.argv[1:] not in ([], ["--wait-off"]):
    sys.exit("Usage: tools/pull-debug-status [--wait-off]")
deadline = time.monotonic() + (6 if sys.argv[1:] else 0)
path = Path.home() / ".drivenbymoss/pull/debug/runtime-status.txt"
while True:
    try:
        pid, state = path.read_text().strip().split("\t")
        pid = int(pid)
        if pid <= 1:
            raise ValueError("invalid process")
        os.kill(pid, 0)
    except (OSError, ValueError):
        print("No live runtime-debug receipt; older shells need a restart.")
        sys.exit(2)
    if state == "OFF":
        print("Runtime debug off: all session workers retired.")
        sys.exit(0)
    if state == "FAILED" or time.monotonic() >= deadline:
        print(f"Runtime debug state: {state}; shutdown is not confirmed.", file=sys.stderr)
        sys.exit(1)
    time.sleep(0.05)
