#!/usr/bin/env python3
"""Build the standalone JMH frame benchmark. Pass remaining arguments directly to JMH."""
from pathlib import Path
import os
import shutil
import subprocess
import sys
import urllib.request

root = Path(__file__).resolve().parent.parent
target = root / "target/display-benchmark"
deps = target / "deps"
classes = target / "classes"
deps.mkdir(parents=True, exist_ok=True)
shutil.rmtree(classes, ignore_errors=True)
classes.mkdir(parents=True, exist_ok=True)
artifacts = {
    "jmh-core-1.37.jar": "org/openjdk/jmh/jmh-core/1.37/",
    "jmh-generator-annprocess-1.37.jar": "org/openjdk/jmh/jmh-generator-annprocess/1.37/",
    "jopt-simple-5.0.4.jar": "net/sf/jopt-simple/jopt-simple/5.0.4/",
    "commons-math3-3.6.1.jar": "org/apache/commons/commons-math3/3.6.1/",
}
for name, path in artifacts.items():
    if not (deps / name).exists():
        urllib.request.urlretrieve("https://repo.maven.apache.org/maven2/" + path + name, deps / name)
classpath = os.pathsep.join(str(deps / name) for name in artifacts)
javac = os.environ.get("PULL_BENCH_JAVAC", "/opt/homebrew/opt/openjdk/bin/javac")
java = os.environ.get("PULL_BENCH_JAVA", "/Applications/Bitwig Studio.app/Contents/PlugIns/JavaVM-arm64.bundle/Contents/Home/bin/java")
sources = list((root / "benchmarks/push-display/src").rglob("*.java"))
production = root / "pull-shell/src/main/java/de/mossgrabers/controller/ableton/push/controller"
sources += [production / "PushColorCalibration.java", production / "PushDebugFrame.java"]
if (production / "PushFrameEncoder.java").exists():
    sources += [production / "PushFrameEncoder.java"]
subprocess.run([javac, "--release", "21", "-cp", classpath, "-processorpath", classpath,
                "-d", str(classes), *map(str, sources)], check=True)
raise SystemExit(subprocess.call([java, "-cp", str(classes) + os.pathsep + classpath,
                                  "org.openjdk.jmh.Main", os.environ.get("PULL_BENCH_FILTER", r"\.FrameBenchmark\."), "-jvm", java, "-foe", "true", *sys.argv[1:]]))
